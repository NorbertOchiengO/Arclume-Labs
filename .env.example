# Contact form configuration. Copy to .env.local and fill in what you use.
# NOTE: every VITE_* variable is bundled into the public site. Never put secrets here.

# Optional. A form service endpoint that accepts a JSON POST
# (for example a Formspree form URL such as https://formspree.io/f/your-form-id).
# When set, the form sends enquiries there. When empty, the form opens the visitor's
# email app addressed to the studio email in src/data/business.js.
VITE_FORM_ENDPOINT=

# Optional. Overrides the address used by the email-app fallback.
# Leave empty to use the email in src/data/business.js.
VITE_CONTACT_EMAIL=
